rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings — public read (booking page needs it), auth write
    match /settings/{document} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Enquiries — public create (contact forms), auth full access
    match /enquiries/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Bookings — public read + create (booking wizard), auth full access
    match /bookings/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Customers — authenticated only
    match /customers/{document} {
      allow read, write: if request.auth != null;
    }

    // Jobs — authenticated only
    match /jobs/{document} {
      allow read, write: if request.auth != null;
    }

    // Invoices — authenticated only
    match /invoices/{document} {
      allow read, write: if request.auth != null;
    }

    // Notifications — authenticated only
    match /notifications/{document} {
      allow read, write: if request.auth != null;
    }

    // WA logs — authenticated only
    match /wa_logs/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
