rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ——— Top-level account records ———
    match /accounts/{garageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerUid ||
         getUserGarageId() == garageId);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // ——— Platform user profiles ———
    match /platform_users/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // ——— Public booking form — unauthenticated creates allowed ———
    match /garages/mot-car-repairs-poole/bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        getUserGarageId() == 'mot-car-repairs-poole';
    }

    // ——— Public enquiry forms — unauthenticated creates allowed ———
    match /garages/mot-car-repairs-poole/enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        getUserGarageId() == 'mot-car-repairs-poole';
    }

    // ——— Settings — public read for slot availability check ———
    match /garages/mot-car-repairs-poole/settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        getUserGarageId() == 'mot-car-repairs-poole';
    }

    // ——— All other tenant-scoped data ———
    match /garages/{garageId}/{document=**} {
      allow read, write: if request.auth != null &&
        getUserGarageId() == garageId;
    }

    // ——— VHC reports — public read ———
    match /garages/{garageId}/vhc_reports/{vhcId} {
      allow read: if true;
      allow write: if request.auth != null &&
        getUserGarageId() == garageId;
    }

    function getUserGarageId() {
      return get(/databases/$(database)/documents/platform_users/$(request.auth.uid)).data.garageId;
    }
  }
}
